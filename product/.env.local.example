# ─────────────────────────────────────────────────────────────────
# MediKiosk — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Bhashini / Dhruva API ────────────────────────────────────────
# Where to get: https://bhashini.gov.in/ulca → Sign Up → Dashboard → API Keys
# Steps:
#   1. Go to https://bhashini.gov.in/ulca
#   2. Click "Sign Up" → register with your email
#   3. Dashboard → "My Profile" → copy userId and API Key
#   4. Also create a Pipeline at Dashboard → Pipelines → Create
#      (select ASR + NMT + TTS tasks for your language pair)
#      Copy the pipelineId shown after creation.
BHASHINI_USER_ID=your_ulca_user_id_here
BHASHINI_API_KEY=your_ulca_api_key_here
NEXT_PUBLIC_BHASHINI_PIPELINE_ID=your_pipeline_id_here

# Dhruva inference endpoint (no key needed — uses BHASHINI_API_KEY above)
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ── ABDM Sandbox ─────────────────────────────────────────────────
# Where to get: https://dev.abdm.gov.in → Sandbox → Register
# Steps:
#   1. Go to https://dev.abdm.gov.in
#   2. Click "Sandbox" → "Register" with your details
#   3. Wait for approval email (usually 1-2 working days)
#   4. Login → "Integrator" → "Create Application"
#   5. Copy Client ID and Client Secret from the app dashboard
#   6. ABHA Sandbox URL: https://abhasbx.abdm.gov.in/abha/api/v3/
ABDM_CLIENT_ID=your_abdm_client_id_here
ABDM_CLIENT_SECRET=your_abdm_client_secret_here
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3
ABDM_ABHA_URL=https://abhasbx.abdm.gov.in/abha/api/v3

# ── Google Gemini API (AI History-Taking LLM) ────────────────────
# Where to get: https://aistudio.google.com/app/apikey
# Steps:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Sign in with your Google account
#   3. Click "Create API key" → select a project (or create new)
#   4. Copy the key shown — it starts with "AIza..."
# Note: Gemini 2.5 Flash is free tier with generous quota for hackathon
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Session Security ─────────────────────────────────────────────
# Generate a random 32-char string:  openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=your_random_32_char_secret_here

# ── Optional: Redis (for Phase 2 session caching) ────────────────
# Leave empty for Phase 1 — not needed yet
# REDIS_URL=redis://localhost:6379

# ── Optional: PostgreSQL (for Phase 2 audit logs) ────────────────
# Leave empty for Phase 1 — not needed yet
# DATABASE_URL=postgresql://user:password@localhost:5432/medikiosk
